  "cross_section_threads": [
    {
      "label": "The Distinction and Hierarchy of Vita Activa",
      "section_ids": [
        "part-0001:sec-prologue",
        "part-0001:sec-ch1-vita-activa",
        "part-0001:sec-ch2-public-private"
      ],
      "description": "The thread tracing labor, work, and action as fundamental categories of the human condition, their distortion by traditional philosophy, and their modern crisis under the rise of society and automation."
    },
    {
      "label": "The Eclipse of Work and Action by Labor",
      "section_ids": [
        "part-0002:sec-003",
        "part-0002:sec-017",
        "part-0002:sec-021"
      ],
      "description": "Tracing how the modern age elevated labor and consumption above durable work and political action."
    },
    {
      "label": "Utilitarianism, Instrumentality, and Meaninglessness",
      "section_ids": [
        "part-0002:sec-027",
        "part-0002:sec-028",
        "part-0002:sec-029"
      ],
      "description": "The inherent paradoxes and ultimate meaninglessness generated when the means-end standards of fabrication are universalized."
    },
    {
      "label": "Action vs. Making (Praxis vs. Poiēsis)",
      "section_ids": [
        "part-0003:sec-004",
        "part-0003:sec-006",
        "part-0003:sec-007"
      ],
      "description": "The tension between action (praxis) and making/fabrication (poiēsis), tracing how philosophical traditions attempt to substitute making for action to avoid uncertainty."
    },
    {
      "label": "The Predicaments of Action and their Remedies",
      "section_ids": [
        "part-0003:sec-003",
        "part-0003:sec-008",
        "part-0003:sec-009"
      ],
      "description": "The inherent boundlessness, unpredictability, and irreversibility of action, and how the internal faculties of forgiving and promising serve as remedies."
    },
    {
      "label": "The Transformation of the Vita Activa",
      "section_ids": [
        "part-0004:sec-004",
        "part-0004:sec-005",
        "part-0004:sec-006"
      ],
      "description": "Traces the sequential displacement of traditional hierarchies within the vita activa, moving from contemplation to fabrication (homo faber), and finally to laboring (animal laborans)."
    },
    {
      "label": "Alienation Forms",
      "section_ids": [
        "part-0004:sec-001",
        "part-0004:sec-002",
        "part-0004:sec-003",
        "part-0004:sec-006"
      ],
      "description": "Examines the intertwined manifestations of world alienation, earth alienation, and introspection throughout the modern age."
    },
    {
      "label": "The Transition from Antiquity to Modernity",
