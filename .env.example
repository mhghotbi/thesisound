# =============================================================================
# Provider credentials
# =============================================================================

# Gemini: ordered key pool. The current key remains active until Gemini returns
# a quota/rate-limit response, then Thesisound moves to the next key.
GEMINI_API_KEYS=["replace-with-key-1","replace-with-key-2"]
# Backward-compatible single key. Leave empty when GEMINI_API_KEYS is used.
GEMINI_API_KEY=

# Okian: OpenAI-compatible provider. When both are set, ungrounded Gemini
# structured-text calls fall back to Okian after Gemini key-pool exhaustion
# (same model ID). Explicit Okian stage routes still require a profile in
# config/model-routing.toml.
OKIAN_BASE_URL=
OKIAN_API_KEY=

# Kavenegar OTP SMS (verify/lookup). When both are set, real SMS replaces NullOtpSender.
# Template must match a verification pattern defined in the Kavenegar panel.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE_NAME=

# Gemini authentication may fall back to Application Default Credentials (ADC).
# Local setup:
# gcloud auth application-default login --scopes="https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/generative-language.retriever"

# =============================================================================
# Gemini outbound proxy (Xray local inbound; upstream failover is in Xray)
# =============================================================================

# Gemini only. Okian always connects directly. Set to "none" to disable.
THESISOUND_HTTP_PROXY=http://127.0.0.1:10809

# =============================================================================
# Model routing
# =============================================================================

# Stage-to-profile routing lives in this TOML file. The committed default keeps
# every structured-text stage on Gemini.
THESISOUND_MODEL_ROUTING_FILE=./config/model-routing.toml

# Optional deployment override. Referenced profiles must exist in the TOML file.
# Example:
  # THESISOUND_MODEL_ROUTE_OVERRIDES={"document_map":"okian_qwen"}
  THESISOUND_MODEL_ROUTE_OVERRIDES={}
  # Experiment E3 (audit R9): route evidence extraction through the production
  # profile mechanism, then compare with `thesisound evidence-tier-report`.
  # Do not use `extract-evidence --model`: that bypasses profile resolution.
  # THESISOUND_MODEL_ROUTE_OVERRIDES={"evidence_extraction":"gemini_strong"}

# Gemini model aliases used by the default routing profiles and as fallbacks.
THESISOUND_MODEL_FAST=gemini-3.5-flash-lite
THESISOUND_MODEL_STRONG=gemini-3.6-flash
# Independent reviewer used by script_verifier. Required before any script can be
# built: while this is empty -- or equal to THESISOUND_MODEL_STRONG -- the writer
# would grade its own script, so script_verifier refuses to run and /script/approve
# is blocked at preflight. Set it to a Gemini model id your account can call that
# is not THESISOUND_MODEL_STRONG.
THESISOUND_MODEL_REVIEWER=

# Dedicated multimodal/audio models are not controlled by text-stage routing.
THESISOUND_MODEL_TTS=gemini-3.1-flash-tts-preview
THESISOUND_MODEL_ASR=gemini-3.6-flash

# Built-in Gemini grounding. Keep grounded stages on Gemini.
THESISOUND_GEMINI_GOOGLE_SEARCH_ENABLED=true
THESISOUND_GEMINI_URL_CONTEXT_ENABLED=true

# =============================================================================
# Source discovery
# =============================================================================

THESISOUND_URL_PROBE_ENABLED=true
THESISOUND_URL_PROBE_TIMEOUT_SECONDS=10
THESISOUND_WEB_SEARCH_CACHE_TTL_HOURS=24

# =============================================================================
# Provider execution and retry policy
# =============================================================================

THESISOUND_MODEL_TIMEOUT_SECONDS=180
THESISOUND_SEARCH_TIMEOUT_SECONDS=120
THESISOUND_TTS_TIMEOUT_SECONDS=240
THESISOUND_ASR_TIMEOUT_SECONDS=180
THESISOUND_OKIAN_TIMEOUT_SECONDS=180
THESISOUND_PROVIDER_MAX_ATTEMPTS=2
THESISOUND_PROVIDER_RETRY_BASE_SECONDS=1
THESISOUND_MODEL_RETRY_BASE_SECONDS=1

# Per-stage fan-out. Both stages are one independent model call per unit of work.
# 1 restores fully sequential execution; raise only if the Gemini key pool has the
# quota headroom, because every worker is a concurrent request against it.
THESISOUND_EVIDENCE_EXTRACTION_WORKERS=4
THESISOUND_DOCUMENT_MAP_WORKERS=4
# Blocks per evidence-extraction call. Leave at 1 until experiment E2 measures
# claim yield and excerpt-error rate against a live provider.
THESISOUND_EVIDENCE_EXTRACTION_BATCH_SIZE=1

THESISOUND_KEEP_RENDERED_PROMPTS=false
THESISOUND_ALLOW_PROVIDER_UPLOADS=true
THESISOUND_KEEP_RAW_PROVIDER_RESPONSES=false

# =============================================================================
# Storage and observability
# =============================================================================

THESISOUND_WORKSPACE_ROOT=./workspaces
THESISOUND_INGESTION_ARTIFACT_ROOT=./artifacts/ingestion
THESISOUND_LOG_LEVEL=INFO

# Metadata: workspaces/_observability/ledger.sqlite3
# Redacted payloads: workspaces/_observability/artifacts/
THESISOUND_OBSERVABILITY_STORE_PAYLOADS=true
# THESISOUND_OBSERVABILITY_DATABASE_PATH=./workspaces/_observability/ledger.sqlite3
# THESISOUND_OBSERVABILITY_ARTIFACT_ROOT=./workspaces/_observability/artifacts
# Accounts and project membership: workspaces/_accounts/accounts.sqlite3
# THESISOUND_ACCOUNTS_DATABASE_PATH=./workspaces/_accounts/accounts.sqlite3

# =============================================================================
# Audio
# =============================================================================

THESISOUND_TTS_VOICE_A=Kore
THESISOUND_TTS_VOICE_B=Puck
THESISOUND_TTS_CHUNK_MAX_CHARACTERS=900
THESISOUND_TTS_WORDS_PER_MINUTE=135
THESISOUND_AUDIO_SAMPLE_RATE_HZ=24000
THESISOUND_AUDIO_QA_PASS_THRESHOLD=0.90
THESISOUND_AUDIO_QA_REVIEW_THRESHOLD=0.78
# Recorded for analysis only; no script gate uses this threshold yet.
THESISOUND_SCRIPT_QUALITY_GATE_ENABLED=false
THESISOUND_SCRIPT_QUALITY_MIN_OVERALL=0.70
# Speaker-balance floor for the script writer (audit R10). Set to false, together with
# `write-script --prompt-version 1.0.0`, to reproduce the pre-R10 behaviour exactly.
THESISOUND_SCRIPT_SPEAKER_BALANCE_ENABLED=true
THESISOUND_AUDIO_MAX_REGENERATION_ATTEMPTS=1
THESISOUND_AUDIO_SILENCE_MILLISECONDS=220
THESISOUND_FFMPEG_COMMAND=ffmpeg

# =============================================================================
# Parser and optional model downloads
# =============================================================================

THESISOUND_MINERU_COMMAND=mineru
THESISOUND_MINERU_TIMEOUT_SECONDS=1800
THESISOUND_MINERU_BACKEND=
THESISOUND_MINERU_MODEL_SOURCE=

# =============================================================================
# Self-hosted OCR
# =============================================================================

# Model snapshots are provisioned explicitly during build/deploy. Runtime uses
# only local paths and fails with MODEL_NOT_PROVISIONED when weights are absent.
THESISOUND_OCR_MODEL_LOCK=./models.lock.json
THESISOUND_OCR_MODEL_ROOT=./.thesisound/models
THESISOUND_OCR_ARTIFACT_ROOT=./artifacts/ingestion/raw/local-ocr

# Use a separate environment containing PaddlePaddle, PaddleOCR, PyMuPDF,
# Pillow, and pypdf. The process is started once per document and exits after it.
THESISOUND_OCR_PYTHON=
THESISOUND_OCR_DEVICE=cpu
THESISOUND_OCR_TIMEOUT_SECONDS=1800

# Heavy structural fallback is disabled by default. Provision and enable only
# after the benchmark shows that difficult pages require PaddleOCR-VL.
THESISOUND_OCR_ENABLE_VLM=false

# Runtime must be offline. Also deny egress with Docker/Kubernetes/firewall.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Provisioning only: export HF_TOKEN in the provisioning shell when higher Hub
# download limits are needed. Do not expose it to the runtime process.
# HF_TOKEN=

# =============================================================================
# Web UI and local development
# =============================================================================

THESISOUND_ENVIRONMENT=development
THESISOUND_WEB_SESSION_SECRET=development-only-session-key
THESISOUND_WEB_SECURE_COOKIES=false
THESISOUND_WEB_UPLOAD_LIMIT_BYTES=52428800
THESISOUND_UI_DEMO_MODE=true

# Development OTP only. Production startup rejects this setting.
THESISOUND_ALLOW_TEST_OTP=true
THESISOUND_TEST_OTP_PHONE=09120000000
THESISOUND_TEST_OTP_CODE=999999
THESISOUND_OTP_TTL_SECONDS=300
THESISOUND_OTP_RESEND_COOLDOWN_SECONDS=30
THESISOUND_OTP_MAX_ATTEMPTS=5

# Password-login lockout for operator accounts, independent of the OTP
# attempt/cooldown limits above.
THESISOUND_PASSWORD_LOGIN_MAX_ATTEMPTS=5
THESISOUND_PASSWORD_LOGIN_LOCKOUT_SECONDS=900
