# Core
THESISOUND_WORKSPACE_ROOT=./workspaces
THESISOUND_LOG_LEVEL=INFO

# Gemini
GEMINI_API_KEY=
THESISOUND_MODEL_FAST=gemini-3.5-flash-lite
THESISOUND_MODEL_STRONG=gemini-3.6-flash
THESISOUND_MODEL_TTS=gemini-3.1-flash-tts-preview

# Search and metadata
FIRECRAWL_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional hosted parser fallback
THESISOUND_ENABLE_FIRECRAWL_PARSE=false

# Safety defaults
THESISOUND_ALLOW_PROVIDER_UPLOADS=true
THESISOUND_KEEP_RAW_PROVIDER_RESPONSES=false
