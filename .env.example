# Model providers
# Preferred: ordered JSON list. The current key stays active until Gemini returns 429,
# then Thesisound moves to the next key. Keys from the same Google project share quota.
GEMINI_API_KEYS=["replace-with-key-1","replace-with-key-2"]
# Backward-compatible single key. Leave empty when GEMINI_API_KEYS is used.
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Core paths
THESISOUND_WORKSPACE_ROOT=./workspaces
THESISOUND_INGESTION_ARTIFACT_ROOT=./artifacts/ingestion
THESISOUND_LOG_LEVEL=INFO

# Runtime
THESISOUND_ENVIRONMENT=development
THESISOUND_MODEL_FAST=gemini-3.5-flash-lite
THESISOUND_MODEL_STRONG=gemini-3.6-flash
THESISOUND_MODEL_TTS=gemini-3.1-flash-tts-preview
THESISOUND_MODEL_ASR=gemini-3.6-flash
THESISOUND_KEEP_RENDERED_PROMPTS=false
THESISOUND_ENABLE_FIRECRAWL_PARSE=false
THESISOUND_ALLOW_PROVIDER_UPLOADS=true
THESISOUND_KEEP_RAW_PROVIDER_RESPONSES=false

# Audio
THESISOUND_TTS_VOICE_A=Kore
THESISOUND_TTS_VOICE_B=Puck
THESISOUND_TTS_CHUNK_MAX_CHARACTERS=900
THESISOUND_TTS_WORDS_PER_MINUTE=135
THESISOUND_AUDIO_SAMPLE_RATE_HZ=24000
THESISOUND_AUDIO_QA_PASS_THRESHOLD=0.90
THESISOUND_AUDIO_QA_REVIEW_THRESHOLD=0.78
THESISOUND_AUDIO_MAX_REGENERATION_ATTEMPTS=1
THESISOUND_AUDIO_SILENCE_MILLISECONDS=220
THESISOUND_FFMPEG_COMMAND=ffmpeg

# Web UI
THESISOUND_WEB_SESSION_SECRET=development-only-session-key
THESISOUND_WEB_SECURE_COOKIES=false
THESISOUND_WEB_UPLOAD_LIMIT_BYTES=52428800
THESISOUND_UI_DEMO_MODE=true

# Development OTP only. Production startup rejects this setting.
THESISOUND_ALLOW_TEST_OTP=true
THESISOUND_TEST_OTP_PHONE=0912000000
THESISOUND_TEST_OTP_CODE=999999
THESISOUND_OTP_TTL_SECONDS=300
THESISOUND_OTP_RESEND_COOLDOWN_SECONDS=30
THESISOUND_OTP_MAX_ATTEMPTS=5

# Parser
THESISOUND_MINERU_COMMAND=mineru
THESISOUND_MINERU_TIMEOUT_SECONDS=1800
THESISOUND_MINERU_BACKEND=
THESISOUND_MINERU_MODEL_SOURCE=
